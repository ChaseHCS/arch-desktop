# Managed by Ansible (arch-desktop). Local edits will be overwritten.
# System-wide GSettings defaults; anything set with `gsettings` or nwg-look
# for your user takes precedence.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Breeze-Dark'
icon-theme='breeze-dark'
cursor-theme='breeze_cursors'
cursor-size=24
font-name='Noto Sans 10'
monospace-font-name='{{ terminal_font }} {{ terminal_font_size }}'
