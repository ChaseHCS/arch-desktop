# fuzzel config, written by the arch-desktop playbook. See fuzzel.ini(5).

[main]
font={{ terminal_font }}:size={{ terminal_font_size | int + 1 }}
terminal={{ hypr_terminal }} -x
layer=overlay
width=45
lines=12

[colors]
background=1a1b26f2
text=c0caf5ff
prompt=7aa2f7ff
input=c0caf5ff
match=7dcfffff
selection=283457ff
selection-text=c0caf5ff
selection-match=7dcfffff
border=7aa2f7ff

[border]
width=2
radius=8
